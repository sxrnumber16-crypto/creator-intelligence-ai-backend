# ---------------------------------------------------------------------------
# Creator Intelligence AI - backend environment
# Copy to apps/backend/.env and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base URL of this backend (used to build OAuth redirect URIs)
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://cia:cia_dev_password@localhost:5432/cia

# Redis for caching + BullMQ background jobs
REDIS_URL=redis://localhost:6379

# Random 64-char hex string. Encrypts Google refresh tokens and AI API keys at rest.
# Generate: openssl rand -hex 32 (twice)
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Google Cloud OAuth 2.0 client (Web application type).
# Authorized redirect URI must be: {PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# YouTube Data API key (public data: competitor lookup, video stats)
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_DATA_API_V3_KEY

# Comma-separated list of extension origins allowed by CORS.
# Find your extension ID after loading unpacked: chrome://extensions
CORS_ORIGINS=chrome-extension://*

# Default AI provider credentials (optional - users can also BYOK in Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Sentry DSN for error tracking
SENTRY_DSN=
